<!-- Negative case (ELY-434): a responder-keystore that names an undefined key-store must be rejected
     at parse time instead of silently falling back to the trust-store. -->
<configuration>
    <authentication-client xmlns="urn:elytron:client:preview:1.8">
        <key-stores>
            <key-store name="client-keystore" type="JKS">
                <file name="./target/keystore/client.keystore"/>
                <key-store-clear-password password="password"/>
            </key-store>
        </key-stores>
        <ssl-contexts>
            <ssl-context name="stapling-unknown-responder-keystore">
                <trust-store key-store-name="client-keystore"/>
                <accept-ocsp-stapling accept-ocsp="true" responder-keystore="does-not-exist" responder-certificate="ca"/>
            </ssl-context>
        </ssl-contexts>
        <ssl-context-rules>
            <rule use-ssl-context="stapling-unknown-responder-keystore">
                <match-host name="stapling-unknown-responder-keystore"/>
            </rule>
        </ssl-context-rules>
    </authentication-client>
</configuration>
