<!-- Negative case (ELY-434): a responder-keystore only serves to locate the responder-certificate,
     so specifying it without a responder-certificate must be rejected at parse time. -->
<configuration>
    <authentication-client xmlns="urn:elytron:client:preview:1.8">
        <key-stores>
            <key-store name="client-keystore" type="JKS">
                <file name="./target/keystore/client.keystore"/>
                <key-store-clear-password password="password"/>
            </key-store>
        </key-stores>
        <ssl-contexts>
            <ssl-context name="stapling-responder-keystore-no-cert">
                <trust-store key-store-name="client-keystore"/>
                <accept-ocsp-stapling accept-ocsp="true" responder-keystore="client-keystore"/>
            </ssl-context>
        </ssl-contexts>
        <ssl-context-rules>
            <rule use-ssl-context="stapling-responder-keystore-no-cert">
                <match-host name="stapling-responder-keystore-no-cert"/>
            </rule>
        </ssl-context-rules>
    </authentication-client>
</configuration>
